{
  "flow_type": "template",
  "flow_name": "comp_radio_button_grid",
  "status": "released",
  "flow_subtype": "component_demo",
  "rows": [
    {
      "type": "subtitle",
      "name": "parameters",
      "value": "Parameters",
      "exclude_from_translation": true
    },
    {
      "name": "concat_name",
      "value": "_name"
    },
    {
      "name": "concat_input",
      "value": "_input"
    },
    {
      "name": "concat_description",
      "value": "_description"
    },
    {
      "type": "title",
      "name": "title_1",
      "value": "Radio Button Grid",
      "exclude_from_translation": true
    },
    {
      "type": "begin_items",
      "value": "@data.comp_radio_button_grid_params",
      "condition": false
    },
    {
      "type": "begin_display_group",
      "name": "@item.id"
    },
    {
      "type": "text",
      "name": "@item.id@local.concat_name",
      "value": "@item.id",
      "style_list": "width: 150px"
    },
    {
      "type": "text_box",
      "name": "@item.id@local.concat_input",
      "value": "@item.default_value",
