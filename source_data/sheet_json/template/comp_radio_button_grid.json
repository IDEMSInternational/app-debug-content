      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Style: secondary"
    },
    {
      "type": "radio_button_grid",
      "action_list": "changed | emit:force_reprocess;",
      "parameter_list": "answer_list: @data.comp_radio_button_flex_data; \nvariant: flex;\nstyle: secondary;\nitem_width: 60px;\ngrid_gap: 8px;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Images only"
    },
    {
      "type": "radio_button_grid",
      "parameter_list": "answer_list: @data.comp_radio_button_flex_img_data; \nvariant: flex;\nstyle: secondary;\nitem_width: 60px;\ngrid_gap: 8px;",
      "exclude_from_translation": true
    },
    {
      "type": "title",
      "value": "Card variant"
    },
    {
      "type": "radio_button_grid",
      "parameter_list": "answer_list: @data.comp_radio_button_grid_data_alt; \nitem_width: @local.item_width_input;\ngrid_width: @local.grid_width_input;\ngrid_gap: @local.grid_gap_input;\noptions_key: id;\noptions_value: label;\nvariant: card;\nstyle: secondary;",
      "exclude_from_translation": true
    },
    {
      "type": "begin_radio_button_grid",
      "parameter_list": "item_width: @local.item_width_input;\ngrid_width: @local.grid_width_input;\ngrid_gap: @local.grid_gap_input;\noptions_key: id;\noptions_value: label;\nvariant: card;",
      "exclude_from_translation": true
    },
    {
      "type": "data_items",
      "value": "comp_radio_button_grid_data_alt"
    },
    {
      "type": "end_radio_button_grid"
    },
    {
      "type": "text",
      "name": "sheet_link",
      "value": "Debug Sheet https://docs.google.com/spreadsheets/d/1yHLQHxZQuxs34gBU-ny95ZWs9e8-HybC4IAeFxwpcVw"
