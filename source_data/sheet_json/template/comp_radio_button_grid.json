      "action_list": "changed | emit:force_reprocess;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "@item.id@local.concat_input",
      "condition": "!@item.default_value",
      "style_list": "width: 100px"
    },
    {
      "type": "text",
      "name": "@item.id@local.concat_description",
      "value": "@item.description",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_items"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "item_width",
      "style_list": "width: 150px"
    },
    {
      "type": "text_box",
      "name": "item_width_input",
      "value": "200px",
      "style_list": "width: 100px",
      "action_list": "changed | emit:force_reprocess;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Minimum item width, will increase to fit grid;",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "grid_width",
      "style_list": "width: 150px"
    },
    {
      "type": "text_box",
      "name": "grid_width_input",
      "value": "100%",
      "style_list": "width: 100px",
      "action_list": "changed | emit:force_reprocess;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Maximum grid width, if specified will center items in available space.\nUse fixed or relative units, such as '75%' or '500px'",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "grid_gap",
      "style_list": "width: 150px"
    },
    {
      "type": "text_box",
      "name": "grid_gap_input",
      "value": "16px",
      "style_list": "width: 100px",
      "action_list": "changed | emit:force_reprocess;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "Spacing between grid items",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "subtitle",
      "name": "output",
      "value": "Output"
