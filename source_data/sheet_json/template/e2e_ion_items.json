    },
    {
      "type": "text",
      "value": "Accordion content",
      "style_list": "border-left: 6px solid #0077cc; border-right: 6px solid #e67e00;"
    },
    {
      "type": "end_accordion_section"
    },
    {
      "type": "begin_accordion_section",
      "name": "section_2",
      "value": "Accordion section 2"
    },
    {
      "type": "text",
      "value": "Accordion content",
      "style_list": "border-left: 6px solid #0077cc; border-right: 6px solid #e67e00;"
    },
    {
      "type": "end_accordion_section"
    },
    {
      "type": "end_accordion"
    },
    {
      "type": "radio_list",
      "name": "radio_list_1",
      "parameter_list": "answer_list: @local.answer_list;"
    },
    {
      "type": "combo_box",
      "name": "combo_box_dropdown",
      "parameter_list": "answer_list: @local.answer_list; variant: dropdown; placeholder: Combo box (dropdown);"
    },
    {
      "type": "begin_template",
      "name": "e2e_markers",
      "value": "e2e_markers"
