{
  "flow_type": "template",
  "flow_name": "debug_remote_assets",
  "status": "released",
  "flow_subtype": "debug",
  "rows": [
    {
      "type": "title",
      "name": "title",
      "value": "Remote assets"
    },
    {
      "type": "text",
      "value": "Watch the metadata panel while pressing buttons. It is empty until a pack has been downloaded."
    },
    {
      "type": "title",
      "value": "Asset pack metadata (_asset_packs)"
    },
    {
      "type": "begin_data_items",
      "value": "_asset_packs"
    },
    {
      "type": "text",
      "value": "id: @item.id\nstatus: @item.download_status\ndownloaded: @item.assets_downloaded_count / @item.assets_total_count\nstarted_at: @item.download_started_at\ncompleted_at: @item.download_completed_at"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "text",
      "value": "download_in_progress: @fields._asset_pack_download_in_progress"
    },
    {
      "type": "title",
      "value": "Asset pack 1"
    },
    {
      "type": "button",
      "value": "Pack 1: ensure_downloaded",
      "action_list": "click | asset_pack: ensure_downloaded | asset_pack: debug_asset_pack_1;"
    },
    {
      "type": "button",
      "value": "Pack 1: download, 3s per file",
      "action_list": "click | asset_pack: download: debug_asset_pack_1 | debug_download_delay_ms: 3000;"
    },
    {
      "type": "title",
      "value": "Asset pack 2"
    },
    {
      "type": "text",
      "value": "debug_asset_pack_2 contains one file that has a reference but is missing; one very large file (400MB); and one normal file"
    },
    {
      "type": "button",
      "value": "Pack 2: ensure_downloaded",
      "action_list": "click | asset_pack: ensure_downloaded | asset_pack: debug_asset_pack_2;"
    },
    {
      "type": "button",
      "value": "Pack 2: download",
      "action_list": "click | asset_pack: download: debug_asset_pack_2"
    },
    {
      "type": "title",
      "value": "Asset pack 3"
    },
    {
      "type": "text",
      "value": "debug_asset_pack_3 contains 100 files of about 1MB each (about 100MB total), all in asset_pack_debugging_bulk/. Tests many small files rather than a few large ones: per-file progress writes, resume part-way through a long pack, and whether the UI stays responsive."
    },
    {
      "type": "text",
      "value": "Interrupt test: start the download, force-quit the app part-way, relaunch. The pack should resume automatically and the downloaded count should carry on from where it stopped rather than restarting at 0."
    },
    {
      "type": "button",
      "value": "Pack 3: ensure_downloaded",
      "action_list": "click | asset_pack: ensure_downloaded | asset_pack: debug_asset_pack_3;"
    },
    {
      "type": "button",
      "value": "Pack 3: download",
      "action_list": "click | asset_pack: download: debug_asset_pack_3"
    },
    {
      "type": "button",
      "value": "Pack 3: download in background (does not block action queue)",
      "action_list": "click | asset_pack: ensure_downloaded | asset_pack: debug_asset_pack_3 | await: false;"
    },
    {
      "type": "button",
      "value": "Pack 3: download, 200ms per file",
      "action_list": "click | asset_pack: download: debug_asset_pack_3 | debug_download_delay_ms: 200;"
    },
    {
      "type": "title",
      "value": "All packs / global"
    },
    {
      "type": "set_variable",
      "name": "asset_pack_list",
      "value": "debug_asset_pack_1; debug_asset_pack_2; debug_asset_pack_3"
    },
    {
      "type": "button",
      "value": "Download all (ensure_downloaded)",
      "action_list": "click | asset_pack: ensure_downloaded | asset_pack_list: @local.asset_pack_list;"
    },
    {
      "type": "button",
      "value": "Cancel in-progress downloads",
      "action_list": "click | asset_pack: cancel_download;"
    },
    {
      "type": "button",
      "value": "Reset (delete all files, clear all lists)",
      "action_list": "click | asset_pack: reset;"
    },
    {
      "type": "title",
      "value": "Select language:"
    },
    {
      "type": "set_variable",
      "name": "language_list",
      "value": "[{\"name\":\"gb_en\",\"text\":\"English\"},{\"name\":\"es_sp\",\"text\":\"Español\"}]"
    },
    {
      "type": "radio_group",
      "name": "language_select",
      "value": "@fields._app_language",
      "action_list": "changed | emit: set_language: @local.language_select;",
      "parameter_list": "answer_list: @local.language_list"
    },
    {
      "type": "title",
      "value": "Asset cases (pack 1)"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Replaces core equivalent:",
      "style_list": "width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging/image_1.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "No core equivalent:",
      "style_list": "width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging/image_2.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Adds an override:",
      "style_list": "width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging/image_3.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Replaces core and override:",
      "style_list": "width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging/image_4.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "No core version, override only:",
      "style_list": "width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging/image_5.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "After deleting pack 1: images 1, 3, 4 revert to their core versions. Images 2 and 5 have no core version, so a missing image here is CORRECT, not a bug."
    },
    {
      "type": "title",
      "value": "Asset cases (pack 3)"
    },
    {
      "type": "text",
      "value": "First and last file of the bulk pack, to confirm the whole pack integrated and not just the start of it. Neither has a core version, so both are correctly missing until pack 3 has downloaded."
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging_bulk/bulk_001.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "image",
      "value": "asset_pack_debugging_bulk/bulk_100.png",
      "style_list": "max-width:140px"
    },
    {
      "type": "end_display_group"
    }
  ]
}